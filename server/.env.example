# Supabase: Project Settings -> Database -> Connection string (use the "Transaction pooler" URI for serverless-friendly limits)
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxx.supabase.co:5432/postgres

PORT=4000
CLIENT_URL=http://localhost:5173

# The single admin account. Generate the hash with: npm run hash-password -- "your-password"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=

# Any long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me
